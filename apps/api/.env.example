# Base PostgreSQL locale (npm run db:local) — ou celle de docker-compose.
# pgbouncer=true : PGlite partage une seule session entre toutes les connexions ;
# ce réglage empêche Prisma de nommer ses requêtes préparées, qui entreraient en
# conflit entre l'API et un script lancé en parallèle (données de démo, migrations).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/postgres?connection_limit=1&sslmode=disable&pgbouncer=true"
# Secret de signature des jetons d'accès : une longue chaîne aléatoire en production.
JWT_ACCESS_SECRET="change-moi-en-une-longue-chaine-aleatoire"
# Adresse de l'interface (CORS et cookies).
WEB_ORIGIN="http://localhost:5173"
PORT=4100
# Dossier des photos envoyées (créé au démarrage).
UPLOAD_DIR="./uploads"
